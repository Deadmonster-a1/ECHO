<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SpotifyClone" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FBFBFD</item>
        <item name="android:navigationBarColor">#FBFBFD</item>
        <item name="android:windowBackground">#FBFBFD</item>
        <item name="android:windowSplashScreenBackground">#FBFBFD</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_echo_splash_icon</item>
    </style>

    <style name="Theme.Echo" parent="Theme.SpotifyClone" />

    <style name="Theme.Echo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FBFBFD</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_echo_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Echo</item>
    </style>
</resources>
